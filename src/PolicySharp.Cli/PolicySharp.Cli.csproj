<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>policysharp</ToolCommandName>
    <PackageId>loach.PolicySharp.Tool</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>mao2009</Authors>
    <Description>Fail-closed PolicySharp preflight CLI for .NET codebases and coding agents.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mao2009/PolicySharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.14.0" />
    <ProjectReference Include="../PolicySharp.Analyzers/PolicySharp.Analyzers.csproj" />
    <ProjectReference Include="../PolicySharp.Core/PolicySharp.Core.csproj" />
  </ItemGroup>
</Project>
