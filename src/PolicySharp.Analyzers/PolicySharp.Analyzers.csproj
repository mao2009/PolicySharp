<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>loach.PolicySharp.Analyzers</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Authors>mao2009</Authors>
    <Description>Default-deny architectural guardrails for .NET codebases and AI coding agents.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mao2009/PolicySharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <ProjectReference Include="../PolicySharp.Core/PolicySharp.Core.csproj" PrivateAssets="all" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />

    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive/PolicySharp.Analyzers.props"
          Pack="true"
          PackagePath="buildTransitive/PolicySharp.Analyzers.props" />
    <None Include="$(OutputPath)PolicySharp.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="$(OutputPath)PolicySharp.Core.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>
</Project>
