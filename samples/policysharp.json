{
  "version": 1,
  "mode": "default-deny",
  "scopes": [
    {
      "id": "domain",
      "match": {
        "namespace": "Sample.Domain.**"
      },
      "allow": {
        "namespaces": [
          "System",
          "System.Collections.Generic",
          "System.Threading",
          "System.Threading.Tasks",
          "Sample.Domain.**"
        ],
        "capabilities": [
          "pure-computation"
        ],
        "symbols": []
      },
      "deny": {
        "namespaces": [
          "System.Diagnostics",
          "System.Reflection.Emit"
        ],
        "capabilities": [],
        "symbols": []
      }
    }
  ]
}
